        <mxCell id="phB" value="FASE B · Tela Financeiro — lê ml_vendas, sem chamada ao Mercado Pago (ADR-0038 / ADR-0042)" style="text;html=1;align=left;fontSize=11;fontStyle=1;fontColor=#7C3AED;" vertex="1" parent="1">
