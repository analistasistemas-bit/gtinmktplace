          <mxGeometry x="30" y="518" width="500" height="20" as="geometry" />
        </mxCell>
        <mxCell id="m9" value="9. dispara notificar-liberacao (schedule, assinatura)" style="endArrow=block;html=1;fontSize=11;fontColor=#0F766E;strokeColor=#0F766E;strokeWidth=1.5;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="558" as="sourcePoint" /><mxPoint x="790" y="558" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m10" value="10. lê vendas liberadas hoje (ml_vendas.money_release_date, BRT)" style="endArrow=block;html=1;fontSize=11;fontColor=#1F2937;strokeColor=#4B5563;strokeWidth=1.5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="593" as="sourcePoint" /><mxPoint x="1010" y="593" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m11" value="11. alerta: caixa liberado" style="endArrow=block;html=1;fontSize=11;fontColor=#1F2937;strokeColor=#4B5563;strokeWidth=1.5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="628" as="sourcePoint" /><mxPoint x="1450" y="628" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m12" value="12. marca liberacao_notificada_em (idempotente por dia)" style="endArrow=block;html=1;fontSize=11;fontColor=#1F2937;strokeColor=#4B5563;strokeWidth=1.5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="663" as="sourcePoint" /><mxPoint x="1010" y="663" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="note" value="&lt;b&gt;Nota:&lt;/b&gt; não existe conexão do Mercado Pago — a conta MP é lida com o token da conexão &lt;b&gt;mercado_livre&lt;/b&gt; da própria org (ADR-0093), com refresh automático. Se a leitura do MP falhar, estorno/liberação já gravados são preservados e os workers de evento respondem 502 para o QStash re-tentar. O saldo direto do MP retorna 403 — por isso o caixa é calculado por venda liberada (ADR-0031 / ADR-0040)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="712" width="1120" height="62" as="geometry" />
        </mxCell>
