{
  "manifest_version": 3,
  "name": "PubliAI",
  "version": "0.2.1",
  "description": "Minha margem nos anúncios do Mercado Livre, com os dados da sua empresa no PubliAI.",
  "permissions": ["sidePanel", "storage", "alarms"],
  "host_permissions": ["https://*.mercadolivre.com.br/*"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "side_panel": { "default_path": "src/painel/index.html" },
  "content_scripts": [
    {
      "matches": ["https://produto.mercadolivre.com.br/*", "https://www.mercadolivre.com.br/p/*", "https://www.mercadolivre.com.br/*/p/*","https://www.mercadolivre.com.br/up/*", "https://www.mercadolivre.com.br/*/up/*"],
      "js": ["anuncio.js"],
      "run_at": "document_idle"
    },
    { "matches": ["https://lista.mercadolivre.com.br/*"], "js": ["busca-ean.js", "busca.js"], "run_at": "document_idle" }
  ],
  "icons": { "16": "icones/icone-16.png", "32": "icones/icone-32.png", "48": "icones/icone-48.png", "128": "icones/icone-128.png" },
  "action": { "default_title": "PubliAI", "default_icon": { "16": "icones/icone-16.png", "32": "icones/icone-32.png", "48": "icones/icone-48.png", "128": "icones/icone-128.png" } },
  "externally_connectable": { "matches": ["https://app.publiai.daludi.com.br/*"] }
}
