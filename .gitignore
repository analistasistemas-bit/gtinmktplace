# Painel gerado do RoadmapMaestri (scripts/maestri-fase.sh / maestri-painel.sh) — evita
# que um `git add -A` de outro agente trackeie state/roadmap gerados, incluindo os
# temporários do mktemp (um SIGKILL entre mktemp e mv não roda o trap EXIT)
memory/maestri-state.json
memory/RoadmapMaestri.md
memory/.maestri-state.*
memory/.roadmap.*

